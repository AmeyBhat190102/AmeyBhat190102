# Provider mode: auto (use real providers where keys exist) | mock (fully offline)
AURA_PROVIDERS=auto

# Agent reasoning + vision critique (Claude)
ANTHROPIC_API_KEY=
AURA_LLM_MODEL=claude-sonnet-5

# Generated artwork — Ideogram preferred (text-in-image), OpenAI fallback
IDEOGRAM_API_KEY=
OPENAI_API_KEY=

# Image-to-video (Veo/Kling/Minimax via Replicate)
REPLICATE_API_TOKEN=

# Where deliverables are written
AURA_ARTIFACTS=./artifacts

# Optional: explicit Chromium binary for the layout engine
# AURA_CHROMIUM=/usr/bin/chromium
