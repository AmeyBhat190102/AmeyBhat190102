# --- providers ---------------------------------------------------------
# auto = real providers where keys exist, mocks elsewhere | mock = fully offline
AURA_PROVIDERS=auto
ANTHROPIC_API_KEY=
AURA_LLM_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-4-8
IDEOGRAM_API_KEY=          # preferred for text-in-image artwork
OPENAI_API_KEY=            # fallback image gen
RECRAFT_API_KEY=           # vector motifs/logos (SVG) — roadmap
REPLICATE_API_TOKEN=       # Veo/Kling image-to-video

# --- infrastructure ----------------------------------------------------
# Keyless dev default: sqlite + inline jobs. Production: postgres + redis.
DATABASE_URL=sqlite+aiosqlite:///./aura.db
# DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura
# REDIS_URL=redis://localhost:6379
AURA_ARTIFACTS=./artifacts
API_JWT_SECRET=dev-secret-change-me-32bytes-min!!

# --- creative & cost dials ---------------------------------------------
DYNAMIC_PLANNING=true
PROJECT_BUDGET_USD=5.0
STUDIO_BUDGET_USD=20.0
MAX_REVISIONS=2
FINAL_COUNT=5

# Optional: explicit Chromium binary for the layout engine
# AURA_CHROMIUM=/usr/bin/chromium
