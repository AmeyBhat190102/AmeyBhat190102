# ---------------------------------------------------------------------------
# Every value here has a working default. Copy to .env only to change one.
# With no API key set, the app runs fully offline: hashed local embeddings
# and extractive answers. Set a key to switch to real models.
# ---------------------------------------------------------------------------

# --- providers -------------------------------------------------------------
# auto (default) picks a hosted provider when a key is present, else local.
# EMBEDDING_PROVIDER=auto        # auto | openai | local
# LLM_PROVIDER=auto              # auto | openai | anthropic | local

# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- storage ---------------------------------------------------------------
# DATABASE_PATH=./data/inbox.db

# --- chunking --------------------------------------------------------------
# CHUNK_TARGET_CHARS=900
# CHUNK_OVERLAP_CHARS=150
# CHUNK_MIN_CHARS=120

# --- retrieval -------------------------------------------------------------
# RETRIEVAL_TOP_K=5              # chunks placed in the model's context
# RETRIEVAL_CANDIDATE_K=20       # chunks scored before the selection policy
# RETRIEVAL_MIN_SCORE=0.12       # below this, answer "not covered" instead
# RETRIEVAL_DENSE_WEIGHT=0.7     # 1.0 = vectors only, 0.0 = BM25 only
# MAX_CHUNKS_PER_ITEM_IN_CONTEXT=3

# --- ingestion limits ------------------------------------------------------
# MAX_NOTE_CHARS=200000
# MAX_FETCH_BYTES=2000000
# FETCH_TIMEOUT_SECONDS=10
# Allow fetching private/loopback addresses. Only for local testing.
# ALLOW_PRIVATE_NETWORK_FETCH=false

# --- server ----------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
# LOG_FORMAT=json                # json | console
# INGEST_WORKER_COUNT=2
